# 이 파일을 복사해 .env로 만들고 값을 채우세요. (.env는 절대 커밋하지 않습니다)
# Render에서는 Environment 메뉴에, 구글 클라우드 런으로 옮길 때는 그쪽 환경변수 설정에 동일하게 넣으면 됩니다.

# ── 이카운트: 오딘 ──────────────────────────────
ODIN_COM_CODE=
ODIN_USER_ID=
ODIN_API_CERT_KEY=
ODIN_ZONE=

# ── 이카운트: 세광 ──────────────────────────────
SEGWANG_COM_CODE=
SEGWANG_USER_ID=
SEGWANG_API_CERT_KEY=
SEGWANG_ZONE=

# true면 운영(oapi) 서버, 비워두면 테스트(sboapi) 서버 사용
ECOUNT_USE_PRODUCTION=

# ── AI 회의실: 값이 있는 AI만 자동으로 회의에 참석합니다 ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 아래 둘은 아직 미사용(발급 후 넣으면 자동 참석)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── 회의록 자동 저장 (선택, 비워두면 저장 안 하고 화면에만 표시) ──
# Make 웹훅 URL을 넣으면 "요약해" 누를 때마다 "회의_핵심요약" 시트로 전송됩니다.
MEETING_SUMMARY_WEBHOOK_URL=
# Make 웹훅 URL을 넣으면 모든 발언이 "회의_전체원문" 시트로 전송됩니다.
MEETING_RAW_WEBHOOK_URL=
